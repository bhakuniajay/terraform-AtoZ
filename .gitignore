# Local .terraform directories (Where the heavy provider binaries live)
**/.terraform/*

# .tfstate files (Contains secrets and local state tracking)
*.tfstate
*.tfstate.*

# Crash logs
crash.log
crash.*.log

# Exclude sensitive variable files (if you use them)
*.tfvars
*.tfvars.json

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json
*.pem
*.env